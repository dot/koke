{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koke",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Request logs would record invitation codes from /invite/<code> URLs (ADR 2: codes never reach logs).
  "observability": { "enabled": false },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is the PWA's static files; these paths need the Worker.
    "run_worker_first": ["/api/*", "/invite/*", "/manifest/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "koke",
      "database_id": "6e83e00e-0457-4fea-83d7-fb780ba304fe",
      "migrations_dir": "migrations"
    }
  ]
}
